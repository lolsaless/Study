# 이 파일을 data/api_keys.env 로 복사해서 키를 넣으세요(data/api_keys.env 는 git 에 올라가지 않습니다).
# 공공데이터포털(data.go.kr) 일반 인증키(Decoding) — 수질자동측정망(국립환경과학원), 기상청 ASOS 일자료 공용
DATA_GO_KR_KEY=
# 기상청 API허브(apihub.kma.go.kr) 인증키 — 시간자료(kma_sfctm3) 등
KMA_AUTH_KEY=
# 한강홍수통제소(hrfco.go.kr) Open API 키 — 수위·유량·우량 (국내 인터넷에서만 접속됨)
HRFCO_KEY=
# WAMIS(wamis.go.kr) Open API 키 — 전국 수위·유량 일자료(낙동강·금강·영산강 유량 보완)
WAMIS_KEY=
